# Use the real FastAPI backend by default. Set this to true only when reviewing
# the frontend without a running backend.
VITE_USE_MOCK_API=false

# Local FastAPI server started from backend/ with uvicorn.
VITE_API_BASE_URL=http://localhost:8000

# Future backend endpoint that receives selectedModelId plus questionnaire inputs and
# returns the ordered, backend-selected model comparisons.
VITE_MODEL_COMPARISONS_PATH=/api/v1/model-comparisons
